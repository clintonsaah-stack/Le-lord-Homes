# Environment Configuration Template
# Copy this file to .env.local and fill in your actual values

# WhatsApp Configuration
NEXT_PUBLIC_WHATSAPP_NUMBER=+[PLACEHOLDER: WhatsApp number with country code]

# Contact Information
NEXT_PUBLIC_BUSINESS_EMAIL=[PLACEHOLDER: Business email]
NEXT_PUBLIC_BUSINESS_PHONE=+[PLACEHOLDER: Business phone]

# Social Media
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/[PLACEHOLDER: Handle]

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=
